# Render > Environment mein ye variables set karo (asli values yahan mat likho)

DATABASE_URL=postgres://user:pass@host:5432/dbname

# Private sales report ka permanent secret URL (/<REPORT_PATH>), sirf A-Z a-z 0-9 _ -
REPORT_PATH=

# Discount / complimentary approval password (set na ho to approval band rahega)
DISCOUNT_PASSWORD=

# Razorpay (live keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Paytm: live ke liye PAYTM_ENV=prod
PAYTM_ENV=prod
PAYTM_MID=
PAYTM_KEY=
PAYTM_POS_ID=
PAYTM_CLIENT_ID=
# Optional
# Own-QR mode (no Paytm QR API): merchant UPI id, QR is built in the server
PAYTM_UPI_ID=
PAYTM_PAYEE_NAME=
# Only if you have no PAYTM_KEY: 16+ random chars; give Paytm the callback URL as .../api/paytm/callback?s=<this value>
PAYTM_CALLBACK_SECRET=
# 1 = auto-confirm callbacks that have no signature/secret (anyone knowing the order id could fake one). Prefer PAYTM_KEY or PAYTM_CALLBACK_SECRET.
PAYTM_TRUST_CALLBACK=
PAYTM_LOG_KEY=
PAYTM_FORWARD_URL=
