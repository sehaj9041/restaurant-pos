# Render > Environment mein ye variables set karo (asli values yahan mat likho)

DATABASE_URL=postgres://user:pass@host:5432/dbname

# Private sales report ka permanent secret URL (/<REPORT_PATH>), sirf A-Z a-z 0-9 _ -
REPORT_PATH=

# Discount / complimentary approval password (set na ho to approval band rahega)
DISCOUNT_PASSWORD=

# Razorpay (live keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Paytm: live ke liye PAYTM_ENV=prod
PAYTM_ENV=prod
PAYTM_MID=
PAYTM_KEY=
PAYTM_POS_ID=
PAYTM_CLIENT_ID=
# Optional
PAYTM_LOG_KEY=
PAYTM_FORWARD_URL=
